ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN if [ ! -e /etc/timezone ]; then \ 
    echo "Etc/UTC" > /etc/timezone && \ 
    ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime && \
    apt-get update && \ 
    apt-get install -q -y --no-install-recommends tzdata && \
    rm -rf /var/lib/apt/lists/* ; \ 
    fi

# install packages
RUN apt-get update -q -qq && apt-get install -q -y --no-install-recommends \
    dirmngr gnupg2 ca-certificates lsb-release openssl curl wget \
    python3-dev build-essential git cmake \
    > /dev/null \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3 - --break-system-packages

##
RUN pip install --break-system-packages numpy scipy opencv-python
